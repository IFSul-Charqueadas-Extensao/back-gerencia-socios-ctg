# ================================
# DEPENDENTES — HTTP TESTS
# ================================

@host = http://localhost:8000/api

# ================================
# LOGIN ADMIN
# ================================

# @name loginAdmin
POST {{host}}/auth/login
Content-Type: application/json

{
    "email": "admin@ctg.local",
    "senha": "admin123"
}

###

@adminToken = {{loginAdmin.response.body.$.access_token}}

# ================================
# LISTAR DEPENDENTES
# ================================

###

GET {{host}}/dependentes
X-Auth-Token: {{adminToken}}
Accept: application/json

###

# ================================
# CRIAR DEPENDENTE
# ================================

# @name criarDependente
POST {{host}}/dependentes
X-Auth-Token: {{adminToken}}
Content-Type: application/json

{
    "socio_titular_id": 1,
    "nome_completo": "Teste Dependente API",
    "cpf": "999.111.222-33",
    "telefone": "51999999999",
    "foto": null,
    "data_nascimento": "2015-06-15",
    "dancarino": false
}

###

@dependenteId = {{criarDependente.response.body.$.id}}

# ================================
# BUSCAR DEPENDENTE POR ID
# ================================

GET {{host}}/dependentes/{{dependenteId}}
X-Auth-Token: {{adminToken}}
Accept: application/json

###

# ================================
# ATUALIZAR DEPENDENTE
# ================================

PUT {{host}}/dependentes/{{dependenteId}}
X-Auth-Token: {{adminToken}}
Content-Type: application/json

{
    "socio_titular_id": 1,
    "nome_completo": "Teste Dependente Atualizado",
    "cpf": "999.111.222-33",
    "telefone": "51988887777",
    "foto": null,
    "data_nascimento": "2015-06-15",
    "dancarino": true
}

###

# ================================
# VERIFICAR DEPENDENTE ATUALIZADO
# ================================

GET {{host}}/dependentes/{{dependenteId}}
X-Auth-Token: {{adminToken}}
Accept: application/json

###

# ================================
# TESTE DE MAIORIDADE
# ================================

# @name criarDependenteMaioridade
POST {{host}}/dependentes
X-Auth-Token: {{adminToken}}
Content-Type: application/json

{
    "socio_titular_id": 1,
    "nome_completo": "Teste Maioridade",
    "cpf": "999.111.222-44",
    "telefone": "51977776666",
    "foto": null,
    "data_nascimento": "2000-01-01",
    "dancarino": false
}

###


# ================================
# VERIFICAR DEPENDENTE MAIOR DE IDADE
# ================================

GET {{host}}/dependentes/8
X-Auth-Token: {{adminToken}}
Accept: application/json

###

# ================================
# DEPENDENTES POR SÓCIO TITULAR
# ================================

GET {{host}}/dependentes?socio_titular_id=1
X-Auth-Token: {{adminToken}}
Accept: application/json

###
