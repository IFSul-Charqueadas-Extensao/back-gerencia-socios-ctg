# ============================================================
# GESTÃO DE RECURSOS — HTTP TESTS
# ============================================================

@host = http://localhost:8000/api

# ================================
# LOGIN
# ================================

# @name loginAdmin
POST {{host}}/auth/login
Content-Type: application/json

{
    "email": "admin@ctg.local",
    "senha": "admin123"
}

###

@adminToken = {{loginAdmin.response.body.$.access_token}}

# @name loginFinanceiro
POST {{host}}/auth/login
Content-Type: application/json

{
    "email": "financeiro@ctg.local",
    "senha": "financeiro123"
}

###

@financeiroToken = {{loginFinanceiro.response.body.$.access_token}}

# ================================
# LISTAR RECURSOS
# ================================

GET {{host}}/gestao-recursos
X-Auth-Token: {{adminToken}}
Accept: application/json

###

# ================================
# CRIAR RECURSO
# ================================

# @name criarRecurso
POST {{host}}/gestao-recursos
X-Auth-Token: {{adminToken}}
Content-Type: application/json

{
    "descricao": "Patrocínio Evento da Semana Farroupilha",
    "valor": 1500.00,
    "forma_pagamento": "Pix"
}

###

@recursoId = {{criarRecurso.response.body.$.id}}

# ================================
# BUSCAR RECURSO POR ID
# ================================

GET {{host}}/gestao-recursos/{{recursoId}}
X-Auth-Token: {{adminToken}}
Accept: application/json

###

# ================================
# ATUALIZAR RECURSO
# ================================

PUT {{host}}/gestao-recursos/{{recursoId}}
X-Auth-Token: {{adminToken}}
Content-Type: application/json

{
    "descricao": "Patrocínio Evento da Semana Farroupilha (Confirmado)",
    "valor": 1750.50,
    "forma_pagamento": "Dinheiro"
}

###

# ================================
# EXCLUIR RECURSO
# ================================

DELETE {{host}}/gestao-recursos/{{recursoId}}
X-Auth-Token: {{adminToken}}
Accept: application/json

###

# ================================
# TESTE DE VALIDAÇÃO (ERRO 422)
# ================================

POST {{host}}/gestao-recursos
X-Auth-Token: {{adminToken}}
Content-Type: application/json

{
    "descricao": "",
    "valor": -10,
    "forma_pagamento": "Boleto"
}

